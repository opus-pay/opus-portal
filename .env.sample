# Settings read at build time (NEXT_PUBLIC_*). Copy to .env.local and fill in. Nothing here is secret: it all ends up in the page.

# Phone wallets over WalletConnect: a free project id from cloud.reown.com (add your site address to its allowed list).
# Empty: only the browser wallet (an extension, or a wallet app's own browser) is offered.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# The address of this site, shown to wallets when they ask who is connecting.
# In production: https://www.opusportal.org
NEXT_PUBLIC_SITE_URL=http://localhost:3200

# The WayHand service. Empty: https://wayhand.net.
NEXT_PUBLIC_WAYHAND_URL=

# Footer links. These defaults point at the OPUS repository on GitHub.
NEXT_PUBLIC_GITHUB_URL=https://github.com/opus-pay
NEXT_PUBLIC_DOCS_URL=https://github.com/opus-pay/opus-osx/blob/main
